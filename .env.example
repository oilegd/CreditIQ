# Optional environment variables (copy to .env or set in your shell).
# No secrets are required by this project.

# Override project-root detection (absolute path).
# CREDITIQ_ROOT=C:\path\to\CreditRiskPredictionBankingI

# Use an alternative config file (absolute or relative to the project root).
# CREDITIQ_CONFIG=config/config.yaml

# Logging level: DEBUG | INFO | WARNING | ERROR
CREDITIQ_LOG_LEVEL=INFO

# Set to 1 to make the Streamlit app read synthetic demo outputs under data/synthetic/.
# CREDITIQ_SYNTHETIC=0
