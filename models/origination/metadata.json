    "feature_catalog": {
      "loan_amnt": {
        "category": "uncertain",
        "rationale": "Listed loan amount. Lending Club's data dictionary states that if the credit department reduces the amount, the reduction is reflected here, so it is not purely the applicant's request. Allow-listed for the applicant model (no cleaner requested-amount field exists); flagged."
      },
      "funded_amnt": {
        "category": "at_origination",
        "rationale": "Amount committed by Lending Club during/after credit review. Differs from loan_amnt in only 65 rows. Not used."
      },
      "funded_amnt_inv": {
        "category": "outcome_derived",
        "rationale": "Amount funded by investors after listing; reflects post-decision market behaviour. Never used."
      },
      "term": {
        "category": "pre_underwriting",
        "rationale": "Loan term selected by the applicant (36/60 months)."
      },
      "int_rate": {
        "category": "at_origination",
        "rationale": "Price assigned by Lending Club from its own grade; a product of underwriting. Origination model only."
      },
      "installment": {
        "category": "at_origination",
        "rationale": "Deterministic function of amount, rate and term; inherits int_rate's timing. Origination model only."
      },
      "grade": {
        "category": "at_origination",
        "rationale": "Lending Club's internal risk grade - an output of its own credit model. Not used directly: it is the first character of sub_grade."
      },
      "sub_grade": {
        "category": "at_origination",
        "rationale": "Finer Lending Club risk grade - an output of its own credit model. Origination model only."
      },
      "emp_title": {
        "category": "sensitive",
        "rationale": "Free-text job title (~182k unique values); identifying and noisy. Excluded."
      },
      "emp_length": {
        "category": "pre_underwriting",
        "rationale": "Self-reported employment length."
      },
      "home_ownership": {
        "category": "pre_underwriting",
        "rationale": "Self-reported housing status."
      },
      "annual_inc": {
        "category": "pre_underwriting",
        "rationale": "Self-reported annual income."
      },
      "verification_status": {
        "category": "uncertain",
        "rationale": "Income-verification outcome produced during Lending Club review; may complete after listing. Origination model only."
      },
      "issue_d": {
        "category": "identifier_metadata",
        "rationale": "Issue month. Used for out-of-time splitting and as reference date for credit-history length; not a direct feature."
      },
      "loan_status": {
        "category": "outcome_derived",
        "rationale": "Outcome used to build the target. Never a feature."
      },
      "pymnt_plan": {
        "category": "outcome_derived",
        "rationale": "Flags a hardship payment plan, which only occurs after repayment problems."
      },
      "url": {
        "category": "identifier_metadata",
        "rationale": "Listing URL; 100% empty in this export."
      },
      "desc": {
        "category": "sensitive",
        "rationale": "Borrower free text (77% missing); may contain personal data and dated post-listing edits. Excluded."
      },
      "purpose": {
        "category": "pre_underwriting",
        "rationale": "Loan purpose selected by the applicant."
      },
      "title": {
        "category": "sensitive",
        "rationale": "Free-text loan title; redundant with purpose. Excluded."
      },
      "zip_code": {
        "category": "sensitive",
        "rationale": "3-digit ZIP prefix; geographic proxy that can encode protected characteristics. Excluded."
      },
      "addr_state": {
        "category": "sensitive",
        "rationale": "US state; geographic proxy. Excluded from models; descriptive portfolio analytics only."
      },
      "dti": {
        "category": "pre_underwriting",
        "rationale": "Debt-to-income from self-reported income and bureau debts (excluding the requested loan)."
      },
      "delinq_2yrs": {
        "category": "pre_underwriting",
        "rationale": "Bureau: 30+ day delinquencies in the past 2 years."
      },
      "earliest_cr_line": {
        "category": "pre_underwriting",
        "rationale": "Bureau: earliest credit line date; used to derive credit-history length. Correlates with age (a protected attribute) - see model card."
      },
      "inq_last_6mths": {
        "category": "pre_underwriting",
        "rationale": "Bureau: credit inquiries in the last 6 months."
      },
      "mths_since_last_delinq": {
        "category": "pre_underwriting",
        "rationale": "Bureau: months since last delinquency (missing = none on file)."
      },
      "mths_since_last_record": {
        "category": "pre_underwriting",
        "rationale": "Bureau: months since last public record (missing = none on file)."
      },
      "open_acc": {
        "category": "pre_underwriting",
        "rationale": "Bureau: number of open credit lines."
      },
      "pub_rec": {
        "category": "pre_underwriting",
        "rationale": "Bureau: number of derogatory public records."
      },
      "revol_bal": {
        "category": "pre_underwriting",
        "rationale": "Bureau: total revolving balance."
      },
      "revol_util": {
        "category": "pre_underwriting",
        "rationale": "Bureau: revolving utilisation rate (fraction)."
      },
      "total_acc": {
        "category": "pre_underwriting",
        "rationale": "Bureau: total number of credit lines."
      },
      "initial_list_status": {
        "category": "at_origination",
        "rationale": "Whole vs fractional listing, decided by Lending Club when listing. Origination model only."
      },
      "out_prncp": {
        "category": "outcome_derived",
        "rationale": "Outstanding principal at snapshot - repayment outcome."
      },
      "out_prncp_inv": {
        "category": "outcome_derived",
        "rationale": "Outstanding principal (investor share) at snapshot - repayment outcome."
      },
      "total_pymnt": {
        "category": "outcome_derived",
        "rationale": "Payments received to date - repayment outcome."
      },
      "total_pymnt_inv": {
        "category": "outcome_derived",
        "rationale": "Payments received to date (investor share) - repayment outcome."
      },
      "total_rec_prncp": {
        "category": "outcome_derived",
        "rationale": "Principal received to date - repayment outcome."
      },
      "total_rec_int": {
        "category": "outcome_derived",
        "rationale": "Interest received to date - repayment outcome."
      },
      "total_rec_late_fee": {
        "category": "outcome_derived",
        "rationale": "Late fees received - only exists after late payment."
      },
      "recoveries": {
        "category": "outcome_derived",
        "rationale": "Post charge-off recoveries - only exists after default."
      },
      "collection_recovery_fee": {
        "category": "outcome_derived",
        "rationale": "Post charge-off collection fee - only exists after default."
      },
      "last_pymnt_d": {
        "category": "outcome_derived",
        "rationale": "Date of last payment - repayment outcome."
      },
      "last_pymnt_amnt": {
        "category": "outcome_derived",
        "rationale": "Amount of last payment - repayment outcome."
      },
      "next_pymnt_d": {
        "category": "outcome_derived",
        "rationale": "Next scheduled payment; populated only for active loans (encodes the outcome)."
      },
      "last_credit_pull_d": {
        "category": "outcome_derived",
        "rationale": "Most recent bureau pull by Lending Club, months or years after origination."
      },
      "collections_12_mths_ex_med": {
        "category": "pre_underwriting",
        "rationale": "Bureau: collections in last 12 months excluding medical."
      },
      "mths_since_last_major_derog": {
        "category": "uncertain",
        "rationale": "Bureau: months since a 90+ day rating. Assumed as-of-application like other bureau fields, but refresh timing is undocumented in this export. Used in both models; flagged."
      },
      "policy_code": {
        "category": "identifier_metadata",
        "rationale": "Constant (=1) in this export."
      },
      "application_type": {
        "category": "identifier_metadata",
        "rationale": "Constant ('Individual') in this export."
      }
    },
    "model": {
      "primary_metric": "roc_auc",
      "selection_tolerance": 0.0005,
