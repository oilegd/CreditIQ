          "isotonic"
        ],
        "cv_folds": 5,
        "selection_metric": "brier"
      },
      "threshold": {
        "objective": "f1"
      }
    },
    "evaluation": {
      "bootstrap_reps": 200,
      "bootstrap_ci": 0.95,
      "calibration_bins": 10,
      "shap_sample_size": 2000,
